# --- Secrets: never commit ---
.env
.env.*
!.env.example
.streamlit/secrets.toml
*.pem
*.key

# --- SQLite / local databases: never commit ---
*.sqlite
*.sqlite3
*.sqlite3-journal
*.db
*.db-journal
*.db-wal
*.db-shm
db.sqlite3

# --- Virtual environments ---
.venv/
venv/
env/
.python-version

# --- Python build & cache ---
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
build/
dist/
wheels/
pip-wheel-metadata/
*.egg

# --- Tests, coverage & linters ---
.pytest_cache/
.coverage
.coverage.*
coverage.xml
htmlcov/
.tox/
.nox/
.mypy_cache/
.ruff_cache/
.hypothesis/

# --- Notebooks ---
.ipynb_checkpoints/

# --- Logs & temp files ---
*.log
*.tmp
*.bak
*.swp
*~

# --- Editors / OS ---
.vscode/
.idea/
.DS_Store
Thumbs.db
desktop.ini
.github
